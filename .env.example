# Copy to .env (gitignored) and fill in. Never commit .env.

# --- Required -----------------------------------------------------------------
# ElevenLabs: speech-to-text and text-to-speech.
ELEVENLABS_API_KEY=

# Azure OpenAI: the voice brain (a chat deployment that supports function tools).
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME

# Microphone. Run "npm run devices" and copy the name in quotes, e.g. Mikrofon (...).
JARVIS_MIC=

# --- Optional -------------------------------------------------------------------
# ffplay for playback (ships with the FFmpeg full build). Default: ffplay on PATH.
# JARVIS_FFPLAY=C:/path/to/ffplay.exe

# Claude Code binary (the MCP server that gives the brain its tools).
# Default: the npm global install under %APPDATA%.
# CLAUDE_BIN=C:/path/to/claude.exe

# Folder the Claude Code workers start in. Default: your user folder.
# JARVIS_WORKER_CWD=C:/Users/you

# Worker model (Claude Code --model). Default: your Claude Code default. "sonnet" is faster.
# JARVIS_WORKER_MODEL=sonnet
# JARVIS_TASK_TIMEOUT_MS=1800000

# Where tasks, reports and memory are kept. Default: ~/.jarvis
# JARVIS_DATA_DIR=C:/Users/you/.jarvis

# Wake words. Speech reaches the assistant only when it names one of these, or during an open window.
# Set to empty to listen to everything (not recommended in a shared room).
# JARVIS_WAKE_WORDS=jarvis,luna,claude,klaude,klod,clod,cloud,claud
# JARVIS_WAKE_WINDOW_MS=90000

# Turn-taking. END_SILENCE ends an utterance after this much silence (ms; default from the VAD).
# MERGE waits this long for the rest of a fragment. BARGE_IN is how long you must talk over the reply to cut it off.
# JARVIS_END_SILENCE_MS=600
# JARVIS_MERGE_MS=800
# JARVIS_BARGE_IN_MS=400

# Voice and models.
# JARVIS_LANGUAGE=nb-NO
# ELEVENLABS_VOICE_ID=BRY5wALXFkJsxVM6sEOH
# ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# ELEVENLABS_STT_MODEL=scribe_v3_live
# AZURE_OPENAI_API_VERSION=2024-10-21

# Latency timings to latency.log (0 = off, 1 = timings, 2 = also transcripts' length and text).
# VOICE_DEBUG=1
