# Copy to .env (gitignored) and fill in. Never commit .env.

# Optional. Anthropic API key for the fast streaming brain (needs API credits).
# Without it, each turn runs Claude Code on this PC instead (slower, no credits needed).
# ANTHROPIC_API_KEY=

# ElevenLabs key for speech-to-text and text-to-speech.
ELEVENLABS_API_KEY=

# Discord. The bot token is read from DISCORD_ENV_FILE if not set here.
DISCORD_BOT_TOKEN=
# DISCORD_ENV_FILE=C:\path\to\discord\.env

# Where the bot should join. Use numeric Discord IDs.
JARVIS_GUILD_ID=
JARVIS_CHANNEL_ID=

# Who may speak to the bot: comma-separated Discord user IDs.
VOICE_ALLOWED_USERS=

# Optional tuning (defaults shown in the README).
# JARVIS_MODEL=claude-haiku-5-5
# ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# ELEVENLABS_STT_MODEL=scribe_v3_live
# VOICE_DEFAULT_LANGUAGE=nb-NO
# VOICE_DEFAULT_VOICE=
# VOICE_END_SILENCE_MS=450
# VOICE_MERGE_MS=400
# VOICE_BARGE_IN_MS=250

# Worker (Claude Code on this PC) settings.
# CLAUDE_BIN=C:\path\to\claude.exe
# JARVIS_WORKER_CWD=C:\Users\you
# JARVIS_TASK_TIMEOUT_MS=1800000
