{
  "name": "jarvis-voice",
  "version": "0.1.0",
  "description": "Local voice assistant for Windows: talk to Luna (Azure OpenAI), Claude Code workers do the work.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "devices": "node dist/index.js --devices",
    "test": "npm run build && node test/jarvis.mjs && node test/conversation.mjs",
    "e2e": "npm run build && node test/e2e.mjs",
    "test:tags": "npm run build && node test/tags.mjs"
  },
  "dependencies": {
    "avr-vad": "^1.0.9",
    "ffmpeg-static": "^5.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.4.0"
  }
}
